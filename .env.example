# ---- General ----
APP_ENV=development            # development | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./medislot.db
HOSPITAL_NAME=Sample City Hospital
INTERNAL_API_KEY=              # REQUIRED: long random string; sent as X-Internal-Api-Key header
PUBLIC_BASE_URL=               # public HTTPS URL of this app (ngrok/cloud) - needed for Twilio signature check
RATE_LIMIT_PER_MINUTE=120

# ---- HMS (Akhil's n8n API) ----
HMS_BASE_URL=https://akhil12.app.n8n.cloud/webhook
HMS_PATH_PREFIX=/hms           # use empty value if HMS_BASE_URL points at Akhil's Express service (e.g. http://localhost:4000/api)
HMS_API_KEY=                   # leave empty => local FICTIONAL mock HMS (development only)
HMS_TIMEOUT_SECONDS=10

# ---- OpenAI ----
OPENAI_API_KEY=                # leave empty => scripted mock LLM (limited demo)
OPENAI_MODEL=gpt-4o-mini       # any chat model that supports tool calling

# ---- Telephony (default provider: Twilio) ----
TELEPHONY_PROVIDER=mock        # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=           # E.164, e.g. +1xxxxxxxxxx (used as SMS sender)
STT_LANGUAGE=en-IN
TTS_VOICE=Polly.Aditi
HANDOFF_DIAL_NUMBER=           # optional: live transfer number for handoff (E.164)

# ---- Notifications ----
EMAIL_PROVIDER=mock            # mock | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=mock              # mock | twilio
STAFF_ALERT_EMAIL=
STAFF_ALERT_PHONE=
CALL_SUMMARY_EMAIL=            # defaults to STAFF_ALERT_EMAIL
REMINDER_OFFSET_HOURS=24
REMINDER_POLL_SECONDS=30
REMINDERS_ENABLED=true

# ---- Receptionist behaviour ----
MAX_TOOL_CALLS_PER_TURN=5
MAX_MISUNDERSTANDINGS=3
RETAIN_TRANSCRIPTS=false
EMERGENCY_NUMBER=112
